# Copy to .env.local if you need to override anything. Every value below is
# also the built-in default, so the project runs with no env file at all.

# Matches docker-compose.yml (host port 5433, to avoid colliding with a local
# Postgres install).
DATABASE_URL=postgres://vetting:vetting@localhost:5433/vendor_vetting

# Local inference. No API key: classification and extraction run against Ollama
# on this machine, so the full eval reproduces without an account anywhere.
# Start it with `ollama serve` and pull the two models named in CLAUDE.md §8.1.
OLLAMA_HOST=http://localhost:11434

# Only for a remote database. Managed providers sign with a private root that is
# not in Node's trust store, so the connection needs their CA certificate. Takes
# either the PEM contents (for a serverless platform's env vars) or a path to a
# file (for a developer's machine). Without it, a remote connection verifies and
# fails loudly rather than downgrading silently — see src/db/ssl.ts.
# DATABASE_CA_CERT=/path/to/prod-ca-2021.crt
